<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.MaintenanceView"
             x:DataType="vm:MaintenanceViewModel">

    <Design.DataContext>
        <vm:MaintenanceViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="18,16,18,10">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="Nettoyage &amp; diagnostic" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="18,4,18,18" Spacing="12">

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="Nettoyage du cache" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Supprime les téléchargements en cache et les anciennes versions (brew cleanup)." />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="act primary" Content="Nettoyer"
                                VerticalAlignment="Center"
                                Command="{Binding CleanupCommand}" IsEnabled="{Binding !IsBusy}" />
                    </Grid>
                </Border>

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="Dépendances orphelines" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Retire les formulae installées automatiquement et devenues inutiles (brew autoremove)." />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="act" Content="Retirer"
                                VerticalAlignment="Center"
                                Command="{Binding AutoremoveCommand}" IsEnabled="{Binding !IsBusy}" />
                    </Grid>
                </Border>

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="Diagnostic" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Vérifie l'intégrité de l'installation Homebrew (brew doctor)." />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="act" Content="Lancer brew doctor"
                                VerticalAlignment="Center"
                                Command="{Binding DoctorCommand}" IsEnabled="{Binding !IsBusy}" />
                    </Grid>
                </Border>

                <TextBlock Classes="section" Text="SAUVEGARDE (BREWFILE)" Margin="2,10,0,0" />

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="Exporter la configuration" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Écrit un Brewfile (taps, formulae, casks) — instantané versionnable, utile pour migrer de machine (brew bundle dump)." />
                        </StackPanel>
                        <Button x:Name="ExportBrewfileButton" Grid.Column="1" Classes="act primary"
                                Content="Exporter…" VerticalAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                    </Grid>
                </Border>

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="Importer une configuration" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Installe tout ce qui manque d'après un Brewfile (brew bundle install)." />
                        </StackPanel>
                        <Button x:Name="ImportBrewfileButton" Grid.Column="1" Classes="act"
                                Content="Importer…" VerticalAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
