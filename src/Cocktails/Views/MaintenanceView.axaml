<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:models="using:Cocktails.Core.Models"
             xmlns:loc="using:Cocktails.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.MaintenanceView"
             x:DataType="vm:MaintenanceViewModel">

    <Design.DataContext>
        <vm:MaintenanceViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="18,16,18,10">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{loc:Tr Maint.Subtitle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="18,4,18,18" Spacing="12">

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="{loc:Tr Maint.CacheTitle}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{loc:Tr Maint.CacheDesc}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="act primary" VerticalAlignment="Center"
                                Command="{Binding CleanupCommand}" IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconCleanGeo}" Classes="btnicon onprimary" />
                                <TextBlock Text="{loc:Tr Btn.Clean}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="{loc:Tr Maint.OrphansTitle}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{loc:Tr Maint.OrphansDesc}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="act" VerticalAlignment="Center"
                                Command="{Binding AutoremoveCommand}" IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconUninstallGeo}" Classes="btnicon" />
                                <TextBlock Text="{loc:Tr Btn.Remove}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="{loc:Tr Maint.DiagTitle}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{loc:Tr Maint.DiagDesc}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="act" VerticalAlignment="Center"
                                Command="{Binding DoctorCommand}" IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconDoctorGeo}" Classes="btnicon" />
                                <TextBlock Text="{loc:Tr Btn.RunDoctor}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="mcard">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                <TextBlock Classes="body" Text="{loc:Tr Maint.MissingTitle}" />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="{loc:Tr Maint.MissingDesc}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="act" VerticalAlignment="Center"
                                    Command="{Binding CheckMissingCommand}" IsEnabled="{Binding !IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IconCheckGeo}" Classes="btnicon" />
                                    <TextBlock Text="{loc:Tr Btn.Check}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Résultat sain -->
                        <Border Classes="chip" HorizontalAlignment="Left" IsVisible="{Binding MissingIsHealthy}">
                            <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Success}"
                                       Text="{loc:Tr Maint.NoMissing}" />
                        </Border>

                        <!-- Manques : formule → dépendances absentes -->
                        <ItemsControl ItemsSource="{Binding Missing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MissingDependency">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                                        <TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Top"
                                                   Margin="0,3,12,0" Text="{Binding Formula}" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Missing}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="chip" Margin="0,0,6,6" Background="#33FF5F6D">
                                                        <TextBlock FontSize="11.5" Foreground="{StaticResource Danger}"
                                                                   Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="{loc:Tr Maint.BackupSection}" Margin="2,10,0,0" />

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="{loc:Tr Maint.ExportTitle}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{loc:Tr Maint.ExportDesc}" />
                        </StackPanel>
                        <Button x:Name="ExportBrewfileButton" Grid.Column="1" Classes="act primary"
                                VerticalAlignment="Center" IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconExportGeo}" Classes="btnicon onprimary" />
                                <TextBlock Text="{loc:Tr Btn.Export}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="mcard">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="body" Text="{loc:Tr Maint.ImportTitle}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{loc:Tr Maint.ImportDesc}" />
                        </StackPanel>
                        <Button x:Name="ImportBrewfileButton" Grid.Column="1" Classes="act"
                                VerticalAlignment="Center" IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconInstallGeo}" Classes="btnicon" />
                                <TextBlock Text="{loc:Tr Btn.Import}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
