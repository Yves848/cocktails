<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                   Margin="18,16,18,10" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="18,4,18,18">

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="Surveillance des mises à jour" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Vérifier périodiquement les paquets obsolètes en arrière-plan." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsChecked="{Binding Settings.MonitoringEnabled}" />
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="Fréquence de vérification" />
                        <TextBlock Classes="muted" Text="Intervalle entre deux contrôles automatiques." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="170"
                              IsEnabled="{Binding Settings.MonitoringEnabled}"
                              ItemsSource="{Binding Frequencies}"
                              SelectedItem="{Binding SelectedFrequency}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FrequencyOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="Notifications système" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Prévenir via le centre de notifications quand de nouvelles mises à jour arrivent." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsChecked="{Binding Settings.NotificationsEnabled}" />
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="Confirmer avant désinstallation" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Demander une confirmation pour les actions irréversibles." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsChecked="{Binding Settings.ConfirmBeforeUninstall}" />
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="Chemin de l'exécutable brew" />
                        <TextBlock Classes="muted" Text="Détecté selon l'architecture." />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                               Foreground="{StaticResource TextMuted}"
                               Text="{Binding Settings.BrewPath}" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
