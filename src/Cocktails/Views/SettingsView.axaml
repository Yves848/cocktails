<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                   Margin="18,16,18,10" />
        <StackPanel Grid.Row="1" Margin="18,4,18,18" Spacing="0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="body" Text="Chemin de l'exécutable brew" />
                    <TextBlock Classes="muted" Text="Détecté selon l'architecture." />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                           Text="{Binding BrewPath}" />
            </Grid>
            <Border Classes="hairline" />
            <StackPanel Spacing="8" Margin="0,16,0,0" MaxWidth="420" HorizontalAlignment="Left">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Surveillance des mises à jour, notifications système et confirmation avant désinstallation seront configurables ici (phase 2)." />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
