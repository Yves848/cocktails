<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:loc="using:Cocktails.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                   Margin="18,16,18,10" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="18,4,18,18">

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.Language}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Tr Settings.LanguageDesc}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="170"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageOption">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.Monitoring}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings.MonitoringDesc}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsChecked="{Binding Settings.MonitoringEnabled}" />
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.Frequency}" />
                        <TextBlock Classes="muted" Text="{loc:Tr Settings.FrequencyDesc}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="170"
                              IsEnabled="{Binding Settings.MonitoringEnabled}"
                              ItemsSource="{Binding Frequencies}"
                              SelectedItem="{Binding SelectedFrequency}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FrequencyOption">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Border Classes="hairline" />

                <!-- Mot de passe administrateur : durée de rétention + oubli immédiat. -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Sudo.Lifetime}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Tr Sudo.LifetimeHint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <ComboBox MinWidth="170"
                                  ItemsSource="{Binding SudoLifetimes}"
                                  SelectedItem="{Binding SelectedSudoLifetime}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FrequencyOption">
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="act" Content="{loc:Tr Sudo.Forget}"
                                Command="{Binding ForgetSudoPasswordCommand}" />
                    </StackPanel>
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.Notifications}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings.NotificationsDesc}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsChecked="{Binding Settings.NotificationsEnabled}" />
                </Grid>

                <Border Classes="hairline" />

                <!-- Test des notifications (vérifie la livraison, indépendamment du moniteur). -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.TestNotif}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings.TestNotifDesc}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="act" VerticalAlignment="Center"
                            Command="{Binding TestNotificationCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource IconBellGeo}" Classes="btnicon" />
                            <TextBlock Text="{loc:Tr Settings.TestNotifBtn}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.Background}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings.BackgroundDesc}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsChecked="{Binding Settings.KeepRunningInBackground}" />
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.Confirm}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings.ConfirmDesc}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsChecked="{Binding Settings.ConfirmBeforeUninstall}" />
                </Grid>

                <Border Classes="hairline" />

                <!-- Raccourci du terminal (enregistrable). -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.TerminalShortcut}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings.TerminalShortcutDesc}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="seg" VerticalAlignment="Center">
                        <Button Classes="segbtn" Classes.on="{Binding IsRecordingShortcut}"
                                MinWidth="130" Content="{Binding RecordButtonLabel}"
                                Command="{Binding RecordShortcutCommand}" />
                    </Border>
                </Grid>

                <Border Classes="hairline" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                        <TextBlock Classes="body" Text="{loc:Tr Settings.Analytics}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings.AnalyticsDesc}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsChecked="{Binding AnalyticsEnabled}" IsEnabled="{Binding !IsBusy}" />
                </Grid>

                <TextBlock Classes="section" Text="{loc:Tr Settings.HomebrewSection}" Margin="2,14,0,4" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,10">
                    <TextBlock Grid.Column="0" Classes="body" Text="{loc:Tr Settings.Version}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                               Foreground="{StaticResource TextMuted}"
                               Text="{Binding Environment.Version}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Margin="0,10">
                    <TextBlock Grid.Column="0" Classes="body" Text="{loc:Tr Settings.Prefix}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                               FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMuted}"
                               Text="{Binding Environment.Prefix}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Margin="0,10">
                    <TextBlock Grid.Column="0" Classes="body" Text="{loc:Tr Settings.Cache}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                               FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMuted}"
                               Text="{Binding Environment.Cache}" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
