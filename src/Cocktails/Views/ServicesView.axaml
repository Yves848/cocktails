<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:models="using:Cocktails.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.ServicesView"
             x:DataType="vm:ServicesViewModel">

    <Design.DataContext>
        <vm:ServicesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,16,18,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="brew services" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="act" Content="Rafraîchir"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <ListBox x:Name="List" Grid.Row="1" Classes="rows" Margin="10,0,10,10"
                 ItemsSource="{Binding Services}" IsEnabled="{Binding !IsBusy}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:BrewService">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Panel Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse Classes="dot" Fill="{StaticResource Success}"
                                     IsVisible="{Binding IsRunning}" />
                            <Ellipse Classes="dot" Fill="{StaticResource TextMuted}"
                                     IsVisible="{Binding !IsRunning}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Classes="body" Text="{Binding Name}" />
                            <TextBlock Classes="muted" Text="{Binding StatusLabel}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="act primary small" Content="Démarrer"
                                Margin="0,0,6,0"
                                IsVisible="{Binding !IsRunning}"
                                Command="{Binding #List.((vm:ServicesViewModel)DataContext).StartCommand}"
                                CommandParameter="{Binding}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding IsRunning}">
                            <Button Classes="act small" Content="Redémarrer"
                                    Command="{Binding #List.((vm:ServicesViewModel)DataContext).RestartCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Classes="act danger small" Content="Arrêter"
                                    Command="{Binding #List.((vm:ServicesViewModel)DataContext).StopCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
