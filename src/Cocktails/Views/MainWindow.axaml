<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cocktails.ViewModels"
        xmlns:conv="using:Cocktails.Converters"
        xmlns:ac="using:Avalonia.Data.Converters"
        xmlns:controls="using:Cocktails.Controls"
        xmlns:loc="using:Cocktails.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="600"
        x:Class="Cocktails.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Title="Cocktails"
        Width="860" Height="600" MinWidth="620" MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border Classes="card">
        <Panel>
            <ExperimentalAcrylicBorder IsHitTestVisible="False" CornerRadius="10"
                                       Material="{StaticResource CardMaterial}" />
            <Border CornerRadius="10" IsHitTestVisible="False"
                    Background="{StaticResource CardTint}" />

            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

                <!-- En-tête (zone de déplacement) : feux macOS à gauche, titre en accent. -->
                <Grid x:Name="DragArea" Grid.Row="0" ColumnDefinitions="Auto,Auto,*"
                      Margin="16,13" Background="Transparent">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="CloseBtn" Classes="mac" ToolTip.Tip="{loc:Tr Win.Close}">
                            <Ellipse Width="12" Height="12" Fill="#FF5F57" />
                        </Button>
                        <Button x:Name="MinBtn" Classes="mac" ToolTip.Tip="{loc:Tr Win.Minimize}">
                            <Ellipse Width="12" Height="12" Fill="#FEBC2E" />
                        </Button>
                        <Button x:Name="MaxBtn" Classes="mac" ToolTip.Tip="{loc:Tr Win.Maximize}">
                            <Ellipse Width="12" Height="12" Fill="#28C840" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="title" Text="Cocktails"
                               Foreground="{StaticResource Accent}"
                               Margin="14,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1" Classes="hairline" />

                <!-- Corps : navigation latérale + écran actif -->
                <Grid Grid.Row="2" ColumnDefinitions="196,*">
                    <ListBox Grid.Column="0" x:Name="NavList" Classes="nav"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Grid.Column="0"
                                          Data="{Binding Icon, Converter={x:Static conv:StringToGeometryConverter.Instance}}"
                                          Stroke="{Binding Color, Converter={x:Static conv:StringToBrushConverter.Instance}}"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Width="18" Height="18" Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               Margin="12,0,0,0" FontSize="13.5"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2" IsVisible="{Binding Count}"
                                            Background="{StaticResource Accent}" CornerRadius="999"
                                            MinWidth="20" Height="18" Padding="6,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="0" Classes="hairline" Width="1"
                            HorizontalAlignment="Right" VerticalAlignment="Stretch" />

                    <Grid Grid.Column="1" RowDefinitions="*,Auto">
                        <!-- Écran actif (résolu par le ViewLocator) + overlay « occupé »
                             limité à cette zone (le terminal reste visible en dessous). -->
                        <Panel Grid.Row="0">
                            <ContentControl Content="{Binding CurrentScreen}" />
                            <Border Background="#B3070912" IsVisible="{Binding CurrentScreen.IsBusy}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="14" MaxWidth="560">
                                    <controls:ShakerLoader HorizontalAlignment="Center" />
                                    <TextBlock Classes="body" MaxWidth="360"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding CurrentScreen.StatusMessage}" />
                                </StackPanel>
                            </Border>
                        </Panel>

                        <!-- Terminal intégré : sorties des commandes brew, collapsible. -->
                        <Border Grid.Row="1" Classes="terminal">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="14,6">
                                    <Path Grid.Column="0" Data="{StaticResource IconTerminalGeo}"
                                          Classes="btnicon" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="muted" Margin="9,0,0,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="{loc:Tr Terminal.Title}" />
                                    <Button Grid.Column="3" Classes="act small iconbtn"
                                            ToolTip.Tip="{loc:Tr Terminal.Clear}"
                                            IsVisible="{Binding CurrentScreen.OutputLog.Count}"
                                            Command="{Binding ClearTerminalCommand}">
                                        <Path Data="{StaticResource IconUncheckGeo}" Classes="btnicon" />
                                    </Button>
                                    <Button Grid.Column="4" Classes="act small iconbtn" Margin="6,0,0,0"
                                            ToolTip.Tip="{loc:Tr Terminal.Toggle}"
                                            Command="{Binding ToggleTerminalCommand}">
                                        <Panel>
                                            <Path Data="{StaticResource IconChevronDownGeo}" Classes="btnicon"
                                                  IsVisible="{Binding IsTerminalExpanded}" />
                                            <Path Data="{StaticResource IconChevronUpGeo}" Classes="btnicon"
                                                  IsVisible="{Binding !IsTerminalExpanded}" />
                                        </Panel>
                                    </Button>
                                </Grid>

                                <Border Grid.Row="1" BorderBrush="{StaticResource Hairline}"
                                        BorderThickness="0,1,0,0" Padding="14,10"
                                        IsVisible="{Binding IsTerminalExpanded}">
                                    <Panel>
                                        <TextBlock Classes="term" Foreground="{StaticResource TextMuted}"
                                                   Text="{loc:Tr Terminal.Empty}"
                                                   IsVisible="{Binding !CurrentScreen.OutputLog.Count}" />
                                        <ScrollViewer x:Name="LogScroll" MaxHeight="210"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsVisible="{Binding CurrentScreen.OutputLog.Count}">
                                            <ItemsControl ItemsSource="{Binding CurrentScreen.OutputLog}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Classes="term" Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Panel>
                                </Border>

                                <!-- Saisie : n'exécute que des sous-commandes brew. -->
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="14,8,14,11"
                                      IsVisible="{Binding IsTerminalExpanded}">
                                    <TextBlock Grid.Column="0" Classes="term" VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent}" Text="❯ brew" Margin="0,0,9,0" />
                                    <TextBox Grid.Column="1" x:Name="TerminalBox" Classes="medit"
                                             Text="{Binding TerminalInput}"
                                             PlaceholderText="{loc:Tr Terminal.Prompt}"
                                             FontFamily="Menlo, Consolas, monospace"
                                             IsEnabled="{Binding !CurrentScreen.IsBusy}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ExecuteTerminalCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Classes="hairline" />

                <!-- Barre d'état (reflète l'écran actif) -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="11"
                            Margin="18,11" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                                 IsVisible="{Binding CurrentScreen.IsBusy}"
                                 VerticalAlignment="Center" />
                    <TextBlock Classes="muted" VerticalAlignment="Center"
                               Text="{Binding CurrentScreen.StatusMessage}" />
                </StackPanel>

            </Grid>

            <!-- Splash d'ouverture : shaker animé + wordmark, s'estompe après le
                 démarrage (piloté par MainWindow.axaml.cs). -->
            <Border x:Name="Splash" CornerRadius="10" IsHitTestVisible="False"
                    Background="#F2070912">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                    <Viewbox Width="150" Height="150" HorizontalAlignment="Center">
                        <controls:ShakerLoader />
                    </Viewbox>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Cocktails" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="muted" Text="{loc:Tr App.Tagline}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dialogue de confirmation (superposé, modal) -->
            <Border CornerRadius="10" Background="#B3040509"
                    IsVisible="{Binding CurrentScreen.Confirmation, Converter={x:Static ac:ObjectConverters.IsNotNull}}">
                <Border Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F2101018" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="14"
                        BoxShadow="0 24 60 -12 #B0000000">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="20,20,20,10">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#33FF5F6D"
                                    VerticalAlignment="Top">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Danger}" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z M12 9v4 M12 17h.01" />
                            </Border>
                            <StackPanel Spacing="5">
                                <TextBlock Classes="title" TextWrapping="Wrap"
                                           Text="{Binding CurrentScreen.Confirmation.Title}" />
                                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="280"
                                           Text="{Binding CurrentScreen.Confirmation.Message}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Spacing="8" Margin="20,6,20,18">
                            <Button Classes="act" Content="{loc:Tr Btn.Cancel}"
                                    Command="{Binding CurrentScreen.CancelConfirmationCommand}" />
                            <Button Classes="act danger"
                                    Content="{Binding CurrentScreen.Confirmation.ConfirmLabel}"
                                    Command="{Binding CurrentScreen.ConfirmCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Poignées de redimensionnement (fenêtre sans chrome) : bords + coins,
                 transparentes, câblées à BeginResizeDrag dans MainWindow.axaml.cs. -->
            <Rectangle x:Name="ResizeT" Height="5" VerticalAlignment="Top"
                       HorizontalAlignment="Stretch" Fill="Transparent" Cursor="SizeNorthSouth" />
            <Rectangle x:Name="ResizeB" Height="5" VerticalAlignment="Bottom"
                       HorizontalAlignment="Stretch" Fill="Transparent" Cursor="SizeNorthSouth" />
            <Rectangle x:Name="ResizeL" Width="5" HorizontalAlignment="Left"
                       VerticalAlignment="Stretch" Fill="Transparent" Cursor="SizeWestEast" />
            <Rectangle x:Name="ResizeR" Width="5" HorizontalAlignment="Right"
                       VerticalAlignment="Stretch" Fill="Transparent" Cursor="SizeWestEast" />
            <Rectangle x:Name="ResizeTL" Width="12" Height="12" HorizontalAlignment="Left"
                       VerticalAlignment="Top" Fill="Transparent" Cursor="TopLeftCorner" />
            <Rectangle x:Name="ResizeTR" Width="12" Height="12" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Fill="Transparent" Cursor="TopRightCorner" />
            <Rectangle x:Name="ResizeBL" Width="12" Height="12" HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" Fill="Transparent" Cursor="BottomLeftCorner" />
            <Rectangle x:Name="ResizeBR" Width="12" Height="12" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Fill="Transparent" Cursor="BottomRightCorner" />
        </Panel>
    </Border>
</Window>
