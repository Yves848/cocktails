<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cocktails.ViewModels"
        xmlns:models="using:Cocktails.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="560"
        x:Class="Cocktails.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Title="Cocktails"
        Width="780" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border Classes="card">
        <Panel>

            <!-- Verre dépoli arrondi (frost) + teinte sombre par-dessus. -->
            <ExperimentalAcrylicBorder IsHitTestVisible="False" CornerRadius="10"
                                       Material="{StaticResource CardMaterial}" />
            <Border CornerRadius="10" IsHitTestVisible="False"
                    Background="{StaticResource CardTint}" />

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

                <!-- En-tête (zone de déplacement de la fenêtre) -->
                <Grid x:Name="DragArea" Grid.Row="0" ColumnDefinitions="*,Auto"
                      Margin="18,14" Background="Transparent">
                    <TextBlock Grid.Column="0" Classes="title" Text="Cocktails"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseBtn" Grid.Column="1" Classes="icon" Content="✕"
                            ToolTip.Tip="Fermer" />
                </Grid>

                <Border Grid.Row="1" Classes="hairline" />

                <!-- Barre d'outils : recherche + vues -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="18,14,18,10">
                    <TextBox Grid.Column="0" Classes="medit"
                             PlaceholderText="Rechercher un package…"
                             Text="{Binding SearchQuery}"
                             IsEnabled="{Binding !IsBusy}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="act primary" Margin="8,0,0,0"
                            Content="Rechercher"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Grid.Column="2" Classes="act" Margin="8,0,0,0"
                            Content="Installés"
                            Command="{Binding RefreshInstalledCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Grid.Column="3" Classes="act" Margin="8,0,0,0"
                            Content="Mises à jour"
                            Command="{Binding ShowOutdatedCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </Grid>

                <TextBlock Grid.Row="3" Classes="section" Text="PACKAGES" Margin="18,0,18,6" />

                <!-- Liste des packages -->
                <ListBox x:Name="PackagesList" Grid.Row="4" Classes="rows" Margin="10,0"
                         SelectionMode="Single"
                         ItemsSource="{Binding Packages}"
                         IsEnabled="{Binding !IsBusy}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Package">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Border Classes="badge" Grid.Column="0">
                                    <TextBlock Text="{Binding KindBadge}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Classes="body" Text="{Binding Name}" />
                                    <TextBlock Classes="muted" Text="{Binding KindLabel}" />
                                </StackPanel>

                                <!-- Version installée + pastille « maj dispo » -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Classes="muted" VerticalAlignment="Center"
                                               Text="{Binding InstalledVersion}"
                                               IsVisible="{Binding IsInstalled}" />
                                    <Border Classes="chip" IsVisible="{Binding IsOutdated}">
                                        <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Warning}"
                                                   Text="{Binding LatestVersion, StringFormat='↑ {0}'}" />
                                    </Border>
                                </StackPanel>

                                <!-- Actions par package -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="act primary small" Content="Installer"
                                            IsVisible="{Binding !IsInstalled}"
                                            Command="{Binding #PackagesList.((vm:MainViewModel)DataContext).InstallCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="act danger small" Content="Désinstaller"
                                            IsVisible="{Binding IsInstalled}"
                                            Command="{Binding #PackagesList.((vm:MainViewModel)DataContext).UninstallCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="5" Classes="hairline" Margin="0,10,0,0" />

                <!-- Barre d'état -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10"
                            Margin="18,12">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                                 IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" Text="{Binding StatusMessage}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

            </Grid>
        </Panel>
    </Border>
</Window>
