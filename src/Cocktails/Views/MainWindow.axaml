<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cocktails.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="Cocktails.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cocktails"
        Width="800" Height="500">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Margin="12">

        <!-- Barre d'actions -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0"
                     PlaceholderText="Rechercher un package…"
                     Text="{Binding SearchQuery}"
                     IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="1" Margin="8,0,0,0"
                    Content="Rechercher"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="2" Margin="8,0,0,0"
                    Content="Installés"
                    Command="{Binding RefreshInstalledCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="3" Margin="8,0,0,0"
                    Content="Mises à jour"
                    Command="{Binding ShowOutdatedCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <!-- Barre d'état -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                         IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>

        <!-- Liste des packages -->
        <ListBox ItemsSource="{Binding Packages}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Kind}" Opacity="0.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding InstalledVersion}"
                                   Opacity="0.7" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</Window>
