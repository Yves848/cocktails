<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:models="using:Cocktails.Core.Models"
             xmlns:views="using:Cocktails.Views"
             xmlns:ac="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.InstalledView"
             x:DataType="vm:InstalledViewModel">

    <Design.DataContext>
        <vm:InstalledViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="18,16,18,10">
            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBox Grid.Column="1" Classes="medit" MaxWidth="200" HorizontalAlignment="Left"
                     PlaceholderText="Filtrer (nom)…"
                     Text="{Binding FilterText}" IsEnabled="{Binding !IsBusy}" />
            <CheckBox Grid.Column="2" Content="Racines" VerticalAlignment="Center" Margin="8,0,0,0"
                      ToolTip.Tip="brew leaves — installés explicitement (masque les dépendances auto)"
                      IsChecked="{Binding LeavesOnly}" IsEnabled="{Binding !IsBusy}" />
            <Border Grid.Column="3" Classes="seg" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="segbtn" Classes.on="{Binding IsKindAll}" Content="Tout"
                            Command="{Binding SetKindFilterCommand}"
                            CommandParameter="{x:Static vm:PackageKindFilter.All}" />
                    <Button Classes="segbtn" Classes.on="{Binding IsKindFormula}" Content="Formulae"
                            Command="{Binding SetKindFilterCommand}"
                            CommandParameter="{x:Static vm:PackageKindFilter.Formula}" />
                    <Button Classes="segbtn" Classes.on="{Binding IsKindCask}" Content="Casks"
                            Command="{Binding SetKindFilterCommand}"
                            CommandParameter="{x:Static vm:PackageKindFilter.Cask}" />
                </StackPanel>
            </Border>
            <Button Grid.Column="4" Classes="act" Content="Rafraîchir" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,300">

            <!-- Master : liste -->
            <ListBox x:Name="List" Grid.Column="0" Classes="rows" Margin="10,0,10,10"
                     SelectionMode="Single"
                     SelectedItem="{Binding SelectedPackage}"
                     ItemsSource="{Binding Packages}" IsEnabled="{Binding !IsBusy}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Package">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Classes="badge" Grid.Column="0">
                                <TextBlock Text="{Binding KindBadge}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Classes="body" Text="{Binding Name}" />
                                <TextBlock Classes="muted" Text="{Binding KindLabel}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Text="{Binding InstalledVersion}" />
                            <Button Grid.Column="3" Classes="act danger small" Content="Désinstaller"
                                    Command="{Binding #List.((vm:InstalledViewModel)DataContext).UninstallCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail : volet du package sélectionné -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,0,0">
                <Panel Margin="18,4,18,14">

                    <!-- Aucun paquet sélectionné -->
                    <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="200"
                               Text="Sélectionnez un paquet pour voir son détail."
                               IsVisible="{Binding Details, Converter={x:Static ac:ObjectConverters.IsNull}}" />

                    <!-- Détail -->
                    <ScrollViewer IsVisible="{Binding Details, Converter={x:Static ac:ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="16">
                            <views:PackageDetailView DataContext="{Binding Details}" />

                            <!-- Dépendants installés (brew uses) : avertissement avant désinstallation. -->
                            <StackPanel Spacing="8" IsVisible="{Binding Dependents.Count}">
                                <TextBlock Classes="section" Text="DÉPENDANTS INSTALLÉS" />
                                <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                                           Text="Ces paquets cesseraient de fonctionner si vous le désinstallez." />
                                <ItemsControl ItemsSource="{Binding Dependents}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="chip" Margin="0,0,6,6">
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                                           Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="act small" Content="Réinstaller"
                                        Command="{Binding ReinstallCommand}"
                                        CommandParameter="{Binding SelectedPackage}" />
                                <Button Classes="act small" Content="Épingler"
                                        IsVisible="{Binding !Details.IsPinned}"
                                        Command="{Binding PinCommand}"
                                        CommandParameter="{Binding SelectedPackage}" />
                                <Button Classes="act small" Content="Désépingler"
                                        IsVisible="{Binding Details.IsPinned}"
                                        Command="{Binding UnpinCommand}"
                                        CommandParameter="{Binding SelectedPackage}" />
                                <Button Classes="act danger small" Content="Désinstaller"
                                        Command="{Binding UninstallCommand}"
                                        CommandParameter="{Binding SelectedPackage}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Chargement du détail -->
                    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                                 IsVisible="{Binding IsLoadingDetails}" />
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
