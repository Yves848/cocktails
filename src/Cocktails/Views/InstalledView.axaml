<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:models="using:Cocktails.Core.Models"
             xmlns:ac="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.InstalledView"
             x:DataType="vm:InstalledViewModel">

    <Design.DataContext>
        <vm:InstalledViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,16,18,10">
            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="act" Content="Rafraîchir"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,300">

            <!-- Master : liste -->
            <ListBox x:Name="List" Grid.Column="0" Classes="rows" Margin="10,0,10,10"
                     SelectionMode="Single"
                     SelectedItem="{Binding SelectedPackage}"
                     ItemsSource="{Binding Packages}" IsEnabled="{Binding !IsBusy}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Package">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Classes="badge" Grid.Column="0">
                                <TextBlock Text="{Binding KindBadge}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Classes="body" Text="{Binding Name}" />
                                <TextBlock Classes="muted" Text="{Binding KindLabel}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Text="{Binding InstalledVersion}" />
                            <Button Grid.Column="3" Classes="act danger small" Content="Désinstaller"
                                    Command="{Binding #List.((vm:InstalledViewModel)DataContext).UninstallCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail : volet du package sélectionné -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,0,0">
                <Panel Margin="18,4,18,14">

                    <!-- Aucun paquet sélectionné -->
                    <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="200"
                               Text="Sélectionnez un paquet pour voir son détail."
                               IsVisible="{Binding Details, Converter={x:Static ac:ObjectConverters.IsNull}}" />

                    <!-- Détail -->
                    <ScrollViewer IsVisible="{Binding Details, Converter={x:Static ac:ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="16" DataContext="{Binding Details}"
                                    x:DataType="models:PackageDetails">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="badge" Width="34" Height="34" CornerRadius="10">
                                    <TextBlock Text="{Binding KindBadge}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="{Binding Tap}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Classes="body" Opacity="0.85" TextWrapping="Wrap"
                                       Text="{Binding Description}" />

                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="muted" Text="Version installée" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{Binding InstalledVersion}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="muted" Text="Dernière version" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{Binding StableVersion}" />
                                </Grid>
                            </StackPanel>

                            <Border Classes="chip" HorizontalAlignment="Left" IsVisible="{Binding IsPinned}">
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="épinglé" />
                            </Border>

                            <StackPanel Spacing="8" IsVisible="{Binding HasDependencies}">
                                <TextBlock Classes="section" Text="DÉPENDANCES" />
                                <ItemsControl ItemsSource="{Binding Dependencies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="chip" Margin="0,0,6,6">
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                                           Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Button Classes="act danger small" Content="Désinstaller"
                                    HorizontalAlignment="Left"
                                    Command="{Binding #List.((vm:InstalledViewModel)DataContext).UninstallCommand}"
                                    CommandParameter="{Binding #List.((vm:InstalledViewModel)DataContext).SelectedPackage}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Chargement du détail -->
                    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                                 IsVisible="{Binding IsLoadingDetails}" />
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
