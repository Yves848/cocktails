<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:views="using:Cocktails.Views"
             xmlns:ac="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.OutdatedView"
             x:DataType="vm:OutdatedViewModel">

    <Design.DataContext>
        <vm:OutdatedViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="18,16,18,10">
            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="act" Content="Actualiser l'index" Margin="0,0,8,0"
                    ToolTip.Tip="brew update — rafraîchit la base des formules/casks"
                    Command="{Binding UpdateIndexCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="2" Classes="act" Content="Rafraîchir" Margin="0,0,8,0"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="3" Classes="act primary" Content="Tout mettre à jour"
                    Command="{Binding UpgradeAllCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <!-- Barre d'actions par lot (visible dès qu'une ligne est cochée). -->
        <Border Grid.Row="1" Classes="mcard" Margin="18,0,18,10" Padding="12,8"
                IsVisible="{Binding AnySelected}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Center"
                           Text="{Binding SelectedCount, StringFormat='{}{0} paquet(s) sélectionné(s)'}" />
                <Button Grid.Column="1" Classes="act small" Content="Tout décocher" Margin="0,0,8,0"
                        Command="{Binding ClearChecksCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Grid.Column="2" Classes="act primary small" Content="Mettre à jour la sélection"
                        Command="{Binding BatchUpgradeCommand}" IsEnabled="{Binding !IsBusy}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,300">

            <!-- Master : liste des obsolètes -->
            <ListBox x:Name="List" Grid.Column="0" Classes="rows" Margin="10,0,10,10"
                     SelectionMode="Single"
                     SelectedItem="{Binding SelectedItem}"
                     ItemsSource="{Binding Packages}" IsEnabled="{Binding !IsBusy}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectablePackage">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                      IsChecked="{Binding IsChecked}"
                                      ToolTip.Tip="Sélectionner pour une mise à jour par lot" />
                            <Border Classes="badge" Grid.Column="1">
                                <TextBlock Text="{Binding KindBadge}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Classes="body" Text="{Binding Name}" />
                                <TextBlock Classes="muted" Text="{Binding KindLabel}" />
                            </StackPanel>
                            <Border Grid.Column="3" Classes="chip" Margin="0,0,10,0">
                                <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Warning}"
                                           Text="{Binding LatestVersion, StringFormat='↑ {0}'}" />
                            </Border>
                            <Button Grid.Column="4" Classes="act primary small" Content="Mettre à jour"
                                    Command="{Binding #List.((vm:OutdatedViewModel)DataContext).UpgradeCommand}"
                                    CommandParameter="{Binding Package}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail : volet du paquet sélectionné -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,0,0">
                <Panel Margin="18,4,18,14">
                    <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="200"
                               Text="Sélectionnez un paquet pour voir son détail."
                               IsVisible="{Binding Details, Converter={x:Static ac:ObjectConverters.IsNull}}" />

                    <ScrollViewer IsVisible="{Binding Details, Converter={x:Static ac:ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="16">
                            <views:PackageDetailView DataContext="{Binding Details}" />
                            <Button Classes="act primary small" Content="Mettre à jour"
                                    HorizontalAlignment="Left"
                                    Command="{Binding UpgradeCommand}"
                                    CommandParameter="{Binding SelectedPackage}" />
                        </StackPanel>
                    </ScrollViewer>

                    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                                 IsVisible="{Binding IsLoadingDetails}" />
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
