<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:models="using:Cocktails.Core.Models"
             xmlns:views="using:Cocktails.Views"
             xmlns:controls="using:Cocktails.Controls"
             xmlns:ac="using:Avalonia.Data.Converters"
             xmlns:loc="using:Cocktails.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Design.DataContext>
        <vm:SearchViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="18,16,18,10">
            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBox Grid.Column="1" x:Name="FilterBox" Classes="medit"
                     PlaceholderText="{loc:Tr Placeholder.Search}" ToolTip.Tip="⌘F"
                     Text="{Binding SearchQuery}" IsEnabled="{Binding !IsBusy}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="2" Classes="act primary" Margin="8,0,0,0"
                    Command="{Binding SearchCommand}" IsEnabled="{Binding !IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconSearchGeo}" Classes="btnicon onprimary" />
                    <TextBlock Text="{loc:Tr Nav.Search}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,300">

            <!-- Master : grille de tuiles (résultats de recherche) -->
            <ListBox x:Name="List" Grid.Column="0" Classes="tilebox" Margin="2,0,2,8"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedItem}"
                     ItemsSource="{Binding Packages}" IsEnabled="{Binding !IsBusy}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectablePackage">
                        <Border Classes="tile">
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <controls:AppIcon Grid.Column="0" Width="42" Height="42"
                                                      Homepage="{Binding Homepage}"
                                                      FallbackText="{Binding KindBadge}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding KindLabel}" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                                    <Border Grid.Column="0" Classes="chip" HorizontalAlignment="Left"
                                            VerticalAlignment="Center" IsVisible="{Binding IsInstalled}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Success}" Text="{loc:Tr Chip.Installed}" />
                                    </Border>
                                    <Button Grid.Column="1" Classes="act primary small iconbtn"
                                            IsVisible="{Binding !IsInstalled}"
                                            ToolTip.Tip="{loc:Tr Btn.Install}"
                                            Command="{Binding #List.((vm:SearchViewModel)DataContext).InstallCommand}"
                                            CommandParameter="{Binding Package}">
                                        <Path Data="{StaticResource IconInstallGeo}" Classes="btnicon onprimary" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail : volet du résultat sélectionné -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,0,0">
                <Panel Margin="18,4,18,14">
                    <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="200"
                               Text="{loc:Tr Detail.SelectResult}"
                               IsVisible="{Binding Details, Converter={x:Static ac:ObjectConverters.IsNull}}" />

                    <ScrollViewer IsVisible="{Binding Details, Converter={x:Static ac:ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="16">
                            <views:PackageDetailView DataContext="{Binding Details}" />
                            <Button Classes="act primary small" Content="{loc:Tr Btn.Install}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding !SelectedPackage.IsInstalled}"
                                    Command="{Binding InstallCommand}"
                                    CommandParameter="{Binding SelectedPackage}" />
                            <Border Classes="chip" HorizontalAlignment="Left"
                                    IsVisible="{Binding SelectedPackage.IsInstalled}">
                                <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Success}" Text="{loc:Tr Chip.AlreadyInstalled}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                                 IsVisible="{Binding IsLoadingDetails}" />
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
