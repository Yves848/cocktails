<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:models="using:Cocktails.Core.Models"
             xmlns:loc="using:Cocktails.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.TapsView"
             x:DataType="vm:TapsViewModel">

    <Design.DataContext>
        <vm:TapsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,16,18,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{loc:Tr Taps.Subtitle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="act" HotKey="Cmd+R" ToolTip.Tip="⌘R"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconReinstallGeo}" Classes="btnicon" />
                    <TextBlock Text="{loc:Tr Btn.Refresh}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Ajout d'un tap -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="18,0,18,10">
            <TextBox Grid.Column="0" Classes="medit"
                     PlaceholderText="{loc:Tr Placeholder.Tap}"
                     Text="{Binding NewTapName}" IsEnabled="{Binding !IsBusy}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="act primary" Margin="8,0,0,0"
                    Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconPlusGeo}" Classes="btnicon onprimary" />
                    <TextBlock Text="{loc:Tr Btn.Add}" />
                </StackPanel>
            </Button>
        </Grid>

        <ListBox x:Name="List" Grid.Row="2" Classes="rows" Margin="10,0,10,10"
                 ItemsSource="{Binding Taps}" IsEnabled="{Binding !IsBusy}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:BrewTap">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="body" Text="{Binding Name}" />
                                <!-- Nature du tap (officiel / tiers), traduite. -->
                                <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding Official}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{loc:Tr Tap.Official}" />
                                </Border>
                                <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding !Official}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{loc:Tr Tap.ThirdParty}" />
                                </Border>
                                <!-- Indicateur de confiance : vert si Homebrew est autorisé
                                     à charger le tap, ambre sinon (à approuver). -->
                                <Border Classes="chip" VerticalAlignment="Center" Background="#2637D67A"
                                        IsVisible="{Binding Trusted}"
                                        ToolTip.Tip="{loc:Tr Tooltip.TapTrusted}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Success}" Text="{loc:Tr Tap.Trusted}" />
                                </Border>
                                <Border Classes="chip" VerticalAlignment="Center" Background="#33F5A623"
                                        IsVisible="{Binding !Trusted}"
                                        ToolTip.Tip="{loc:Tr Tooltip.TapToApprove}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Warning}" Text="{loc:Tr Tap.ToApprove}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="muted" Text="{Binding Summary}" />
                        </StackPanel>

                        <!-- Faire confiance : seulement pour un tap tiers pas encore approuvé -->
                        <Button Grid.Column="1" Classes="act small iconbtn" Margin="0,0,6,0"
                                IsVisible="{Binding CanTrust}"
                                ToolTip.Tip="{loc:Tr Tooltip.Trust}"
                                Command="{Binding #List.((vm:TapsViewModel)DataContext).TrustCommand}"
                                CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconTrustGeo}" Classes="btnicon" />
                        </Button>
                        <!-- Retirer (taps tiers uniquement) -->
                        <Button Grid.Column="2" Classes="act danger small iconbtn"
                                IsVisible="{Binding !Official}"
                                ToolTip.Tip="{loc:Tr Btn.Remove}"
                                Command="{Binding #List.((vm:TapsViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconUninstallGeo}" Classes="btnicon danger" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
