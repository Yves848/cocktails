<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocktails.ViewModels"
             xmlns:models="using:Cocktails.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Cocktails.Views.TapsView"
             x:DataType="vm:TapsViewModel">

    <Design.DataContext>
        <vm:TapsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,16,18,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="dépôts de formules / casks" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="act" Content="Rafraîchir"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <!-- Ajout d'un tap -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="18,0,18,10">
            <TextBox Grid.Column="0" Classes="medit"
                     PlaceholderText="utilisateur/dépôt (ex. felixkratz/formulae)"
                     Text="{Binding NewTapName}" IsEnabled="{Binding !IsBusy}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="act primary" Content="Ajouter" Margin="8,0,0,0"
                    Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <ListBox x:Name="List" Grid.Row="2" Classes="rows" Margin="10,0,10,10"
                 ItemsSource="{Binding Taps}" IsEnabled="{Binding !IsBusy}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:BrewTap">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="body" Text="{Binding Name}" />
                                <Border Classes="chip" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding KindLabel}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="muted" Text="{Binding Summary}" />
                        </StackPanel>

                        <!-- Faire confiance (taps tiers) -->
                        <Button Grid.Column="1" Classes="act small" Content="Confiance" Margin="0,0,6,0"
                                IsVisible="{Binding !Official}"
                                ToolTip.Tip="brew trust — autorise Homebrew à charger ce tap"
                                Command="{Binding #List.((vm:TapsViewModel)DataContext).TrustCommand}"
                                CommandParameter="{Binding}" />
                        <!-- Retirer (taps tiers uniquement) -->
                        <Button Grid.Column="2" Classes="act danger small" Content="Retirer"
                                IsVisible="{Binding !Official}"
                                Command="{Binding #List.((vm:TapsViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
