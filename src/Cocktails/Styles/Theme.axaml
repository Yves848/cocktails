<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    ============================================================================
    Design system « command-card » — repris de l'app LedControl (même stack
    Avalonia). Carte translucide sombre + flou acrylique, accent bleu.

    Palette :
      Texte principal   #ECEEF5      Accent            #5B8CFF
      Texte atténué     #9AA0B4      Accent (sélection) #295B8CFF
      Teinte carte      #161826      Succès (à jour)   #37D67A
      Filet/hairline    #12FFFFFF    Danger            #FF5F6D
      Avertissement (maj) #F5A623

    Fond : verre dépoli via ExperimentalAcrylicBorder (teinte #161826) dans une fenêtre
    WindowDecorations="None" + Background transparent. Donne un fond réellement flouté
    sur macOS sans boutons de titre (cf. MainWindow.axaml).
    ============================================================================
  -->
  <Styles.Resources>
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEEF5" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA0B4" />
    <!-- Accent CONFIGURABLE : la couleur est une ressource dynamique ; changer
         AccentColor / AccentSoftColor à l'exécution recolore toutes les liaisons.
         Défaut de la refonte = teal. Réglable dans les Réglages (à venir). -->
    <Color x:Key="AccentColor">#2DD4BF</Color>
    <Color x:Key="AccentSoftColor">#332DD4BF</Color>
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="Success" Color="#43C07A" />
    <SolidColorBrush x:Key="Warning" Color="#F0B429" />
    <SolidColorBrush x:Key="Danger" Color="#F0616B" />
    <SolidColorBrush x:Key="Violet" Color="#A78BFA" />
    <SolidColorBrush x:Key="Hairline" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="FillSubtle" Color="#10FFFFFF" />
    <!-- Bordure 2px qui délimite la carte (filet clair discret sur fond sombre). -->
    <SolidColorBrush x:Key="CardBorder" Color="#59FFFFFF" />
    <!-- Verre dépoli (flou) — fournit la transparence/frost. -->
    <ExperimentalAcrylicMaterial x:Key="CardMaterial"
                                 BackgroundSource="Digger"
                                 TintColor="#05060A"
                                 TintOpacity="0.45"
                                 MaterialOpacity="0.55" />
    <!-- Teinte sombre superposée AU-DESSUS de l'acrylique : contrôle la « noirceur ».
         Seul réglage à toucher pour + / − sombre (alpha du début : ~D9 = 85%). -->
    <SolidColorBrush x:Key="CardTint" Color="#D9070912" />

    <!-- Icônes d'action (tracé au trait, viewBox 24×24, style Lucide) pour les boutons. -->
    <StreamGeometry x:Key="IconReinstallGeo">M23 4v6h-6 M20.49 9A9 9 0 1 0 5.64 5.64L1 10</StreamGeometry>
    <StreamGeometry x:Key="IconUninstallGeo">M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6 M10 11v6 M14 11v6</StreamGeometry>
    <StreamGeometry x:Key="IconRefreshGeo">M23 4v6h-6 M1 20v-6h6 M20.49 9A9 9 0 0 0 5.64 5.64L1 10 M3.51 15a9 9 0 0 0 14.85 4.36L23 14</StreamGeometry>
    <StreamGeometry x:Key="IconUncheckGeo">M18 6L6 18 M6 6l12 12</StreamGeometry>
    <StreamGeometry x:Key="IconPinGeo">M12 17v5 M5 9l7-7 7 7-4 1-3 5-3-5-4-1z</StreamGeometry>
    <StreamGeometry x:Key="IconOpenExtGeo">M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6 M15 3h6v6 M10 14L21 3</StreamGeometry>
    <StreamGeometry x:Key="IconInstallGeo">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3</StreamGeometry>
    <StreamGeometry x:Key="IconUpdateGeo">M12 20V6 M5 13l7-7 7 7 M5 4h14</StreamGeometry>
    <StreamGeometry x:Key="IconSearchGeo">M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M21 21l-4.35-4.35</StreamGeometry>
  </Styles.Resources>

  <!-- Carte : conteneur racine arrondi + bordure 2px. Le fond translucide/flou est fourni par
       un ExperimentalAcrylicBorder placé À L'INTÉRIEUR (cf. MainWindow). -->
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
  </Style>

  <!-- Grille de tuiles : ListBox.tilebox en WrapPanel (sélection + navigation flèches
       natives). La sélection/survol pilote le liseré de la tuile ; on neutralise le
       chrome par défaut du ListBoxItem. -->
  <Style Selector="ListBox.tilebox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ListBox.tilebox ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>
  <Style Selector="ListBox.tilebox ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tilebox ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Background" Value="#151C26" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Width" Value="262" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="Padding" Value="15,14" />
  </Style>
  <Style Selector="ListBox.tilebox ListBoxItem:pointerover Border.tile">
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
  </Style>
  <Style Selector="ListBox.tilebox ListBoxItem:selected Border.tile">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <!-- Focus clavier visible sur la tuile (liseré accent également). -->
  <Style Selector="ListBox.tilebox ListBoxItem:focus-visible Border.tile">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <!-- Icône dans un bouton d'action (trait, alignée au texte). -->
  <Style Selector="Path.btnicon">
    <Setter Property="Stroke" Value="{StaticResource TextPrimary}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.btnicon.danger">
    <Setter Property="Stroke" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Path.btnicon.onprimary">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <!-- Pastille « version disponible » (paquet obsolète) -->
  <Style Selector="Border.verpill">
    <Setter Property="Background" Value="#1FF0B429" />
    <Setter Property="BorderBrush" Value="#4DF0B429" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Filet de séparation 1px -->
  <Style Selector="Border.hairline">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Hairline}" />
  </Style>

  <!-- Textes -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>

  <!-- Badge carré (initiale de type : F = formula, C = cask). -->
  <Style Selector="Border.badge">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{StaticResource FillSubtle}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Pastille d'état -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
  </Style>

  <!-- Bouton icône (carré fixe, contenu centré). -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>

  <!-- Liste navigable au clavier (ListBox.rows) : lignes arrondies, survol + sélection. -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0DFFFFFF" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- Navigation latérale (ListBox.nav) -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,14" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0DFFFFFF" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <!-- Carte de maintenance / réglages -->
  <Style Selector="Border.mcard">
    <Setter Property="Background" Value="#08FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Segmented (filtre par type) -->
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="#33000000" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.segbtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.segbtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0DFFFFFF" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.segbtn.on">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="Button.segbtn.on /template/ ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Puce (pill) : type / catégorie -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Bouton d'action -->
  <Style Selector="Button.act">
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.act:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="Button.act:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#08FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Button.act.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.act.primary:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <!-- Action destructive (désinstaller) : rouge, discret tant qu'on ne survole pas. -->
  <Style Selector="Button.act.danger">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Button.act.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#33FF5F6D" />
  </Style>

  <!-- Feux de circulation macOS (fermer / réduire / agrandir) : bouton sans chrome,
       la pastille de couleur est une Ellipse ; léger assombrissement au survol. -->
  <Style Selector="Button.mac">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mac /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.mac:pointerover Ellipse">
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <!-- Bouton d'action compact (par ligne) -->
  <Style Selector="Button.act.small">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Bouton icône seule (tuiles) : padding carré, l'infobulle porte le libellé. -->
  <Style Selector="Button.act.iconbtn">
    <Setter Property="Padding" Value="7,6" />
  </Style>

  <!-- Champ de saisie -->
  <Style Selector="TextBox.medit">
    <Setter Property="Background" Value="#33000000" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="#22FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="TextBox.medit:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
</Styles>
